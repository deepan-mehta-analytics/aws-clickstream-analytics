# ── Agent workflow files (local-only, never tracked) ──────────
/CLAUDE.md
/workflow_status.md
/workflow_status_archive.md
/MEMORY.md
/feedback_*.md
/reference_*.md
# Private specs, plans and exam study notes (same pattern as databricks-fraud-detection)
/docs/superpowers/

# ── Secrets and credentials ───────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
credentials
.aws/

# ── Terraform / IaC state ─────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
terraform.tfvars
cdk.out/

# ── Local data (large / regenerable datasets) ─────────────────
/data/*
!/data/.gitkeep
!/data/README.md
*.parquet
*.csv
# Local pipeline output (regenerable with `python -m clickstream.local_run`)
/output/

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# ── Editor / OS ───────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
